{
  "name": "@aitutor/db",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "generated/client.js",
  "types": "generated/client.d.ts",
  "exports": {
    ".": "./generated/client.js",
    "./adapter": "./generated/client.js"
  },
  "scripts": {
    "generate": "cd ../.. && DATABASE_URL=${DATABASE_URL:-postgresql://localhost/dummy} node ./node_modules/prisma/build/index.js generate --schema packages/db/prisma/schema.prisma",
    "validate": "cd ../.. && DATABASE_URL=${DATABASE_URL:-postgresql://localhost/dummy} node ./node_modules/prisma/build/index.js validate --schema packages/db/prisma/schema.prisma",
    "migrate:deploy": "cd ../.. && DATABASE_URL=${DATABASE_URL:-postgresql://localhost/dummy} node ./node_modules/prisma/build/index.js migrate deploy --schema packages/db/prisma/schema.prisma",
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "prisma": "7.10.0-integration-fix-prisma-publish-token.1"
  }
}