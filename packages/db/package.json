{
  "name": "@aitutor/db",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "generated/client.js",
  "types": "generated/client.d.ts",
  "exports": {
    ".": "./generated/client.js",
    "./adapter": "./generated/client.js"
  },
  "scripts": {
    "generate": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost/dummy} node ../../node_modules/prisma/build/index.js generate",
    "validate": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost/dummy} node ../../node_modules/prisma/build/index.js validate",
    "migrate:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost/dummy} node ../../node_modules/prisma/build/index.js migrate deploy",
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "prisma": "^8.0.0-rc.3"
  }
}
