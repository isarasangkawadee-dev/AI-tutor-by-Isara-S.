# =============================================================
# AI Tutor by Isara S. — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าให้ตรงกับสภาพแวดล้อมของคุณ
# =============================================================

# Node environment
NODE_ENV=production

# -------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------
# รูปแบบ: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
# Local:  postgresql://aitutor:dev_password_2026@localhost:5432/aitutor?schema=public
# Docker (ใน docker-compose.yml ที่ใช้ service ชื่อ db): postgresql://aitutor:db_password@db:5432/aitutor?schema=public
DATABASE_URL=postgresql://aitutor:CHANGE_ME_PASSWORD@localhost:5432/aitutor?schema=public

# รหัสผ่าน PostgreSQL root (ใช้สำหรับ docker-compose เพื่อสร้างฐานข้อมูล)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# -------------------------------------------------------------
# APP URL — สำคัญมาก
# NEXT_PUBLIC_APP_URL จะถูก "embed" ลงใน client-side build ตอน build
# หากรันที่ URL/PORT อื่น ต้อง set ค่านี้ก่อน build แล้ว build ใหม่
# -------------------------------------------------------------
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ใช้เมื่อ deploy เบื้องหลัง reverse proxy/load balancer (เช่น Railway, Render)
AUTH_TRUST_HOST=true

# ความลับของ session — ต้องมีความยาวอย่างน้อย 32 ตัวอักษร
# สร้างได้ด้วย: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS

# -------------------------------------------------------------
# AI PROVIDER
# "mock" = ใช้คำอธิบายจำลอง (เหมาะกับ dev)
# "openai" หรือ provider อื่น = ใช้จริง ต้องใส่ API key
# -------------------------------------------------------------
AI_PROVIDER=mock
AI_API_KEY=

# -------------------------------------------------------------
# LIMITS
# -------------------------------------------------------------
UPLOAD_MAX_BYTES=10485760
RATE_LIMIT_LOGIN_PER_15M=20
RATE_LIMIT_API_PER_MIN=120

# -------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------
LOG_LEVEL=info

# -------------------------------------------------------------
# SEED ACCOUNTS (กรอกเมื่อรัน db:seed เพื่อสร้างแอดมินพิเศษ)
# ทิ้งว่างได้ หากไม่ต้องการ แอดมินหลักถูกสร้างโดย db:seed อยู่แล้ว
# (admin@aitutor-dev.local / DevAdmin#2026)
# -------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
